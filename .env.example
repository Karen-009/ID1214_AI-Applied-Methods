# Copy this file to .env and fill in the values. Never commit .env.

# Which Jev backend to use: mock | typesafe
#   mock     = keyword heuristic, works offline with no key
#   typesafe = the real Jev model via TypeSafe AI
JEV_BACKEND=mock

# --- typesafe backend ---
# Create a key at https://console.typesafe.ai/keys
JEV_API_KEY=REPLACE_ME
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# jev-latest moves with new releases; pin a version (e.g. jev-1.13.0)
# before tuning thresholds for the final evaluation.
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=15

# Below this confidence the system asks a clarifying question
JEV_CONFIDENCE_THRESHOLD=0.35
